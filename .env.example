# =============================================================================
# ESU Frontend - Plantilla de Variables de Entorno (.env.example)
# =============================================================================

# URL base del Backend Spring Boot (en producción Vercel apuntar a URL de Render con /api)
# Ejemplo Local: http://localhost:8080/api
# Ejemplo Prod: https://esu-backend.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# Autenticación Federada con Google OAuth2 / OpenID Connect
# true para habilitar el botón y flujo; false para deshabilitarlo completamente
VITE_GOOGLE_AUTH_ENABLED=false

# Client ID de Google Cloud OAuth (obligatorio solo si VITE_GOOGLE_AUTH_ENABLED=true)
VITE_GOOGLE_CLIENT_ID=
